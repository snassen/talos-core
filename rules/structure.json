{
  "version": 2,
  "note": "Where every mail should go in the new Talos/ structure (docs/mailbox-structure-plan.md). Read by talos structure plan; nothing here writes to a mailbox. Per account, an ordered list of targets: the first whose conditions all hold places the message. A target is 'inbox' (stays in the inbox, no label; only for mail in the inbox now, the inbox is never refilled), 'label' (a Gmail label or, later, an Exchange folder under Talos/) or 'leave' (never touched). Conditions read the message's effective values (human > rule > accepted model, the thread's values counting too). Edit freely and bump version; the next plan recomputes everything. Fields: sender (sender_kind, else the origin's side), sender_kind, sphere, form, keep, origin, type, topic, value, kind, ask, direction, folder, label, in_inbox, flagged, replied, ask_proposed, age_days. Operators: in, not_in, prefix, set, is, lt, gt; else (when the field has no value, test this instead); any / all (groups); use (a named condition list below).",
  "conditions": {
    "short_lived": [
      {
        "any": [
          {
            "field": "keep",
            "in": [
              "short_lived"
            ]
          },
          {
            "all": [
              {
                "field": "keep",
                "set": false
              },
              {
                "field": "value",
                "in": [
                  "context",
                  "transient",
                  "noise"
                ]
              }
            ]
          }
        ]
      }
    ],
    "not_a_keeper": [
      {
        "field": "value",
        "not_in": [
          "record_financial",
          "record_legal",
          "record_account",
          "knowledge",
          "decision",
          "reference",
          "memory"
        ]
      }
    ],
    "spam": [
      {
        "any": [
          {
            "field": "kind",
            "in": [
              "spam"
            ],
            "else": {
              "field": "type",
              "in": [
                "spam"
              ]
            }
          },
          {
            "field": "origin",
            "in": [
              "spam"
            ]
          }
        ]
      }
    ]
  },
  "blocks": {
    "spam": [
      {
        "id": "spam",
        "place": "label",
        "path": "Talos/Automated/Spam candidates",
        "why": "Spam or phishing by kind, type or origin, unless it is also a record or knowledge. Before the inbox, so a phishing mail posing as a person with a question never keeps its inbox place. Talos never deletes; you decide.",
        "when": [
          {
            "use": "spam"
          },
          {
            "use": "not_a_keeper"
          }
        ]
      }
    ],
    "inbox": [
      {
        "id": "inbox-flagged",
        "place": "inbox",
        "path": "Inbox",
        "why": "You flagged or starred it yourself: your decision beats every rule.",
        "when": [
          {
            "field": "flagged",
            "is": true
          }
        ]
      },
      {
        "id": "inbox-open-ask",
        "place": "inbox",
        "path": "Inbox",
        "why": "A person asks something of you (a question, an action, a decision, a deadline) and you have not replied in the thread since. Jev's ask is still only proposed in the archive, so a proposed ask counts too: keeping mail in the inbox is the cautious side.",
        "when": [
          {
            "field": "sender",
            "in": [
              "people"
            ]
          },
          {
            "any": [
              {
                "field": "ask",
                "set": true
              },
              {
                "field": "ask_proposed",
                "is": true
              }
            ]
          },
          {
            "field": "replied",
            "is": false
          }
        ]
      },
      {
        "id": "inbox-recent",
        "place": "inbox",
        "path": "Inbox",
        "why": "From a person, or not decided yet, and less than 14 days old. New mail has few values when it arrives; it is placed again as it ages.",
        "when": [
          {
            "field": "sender",
            "in": [
              "people"
            ],
            "else": {
              "field": "sender",
              "set": false
            }
          },
          {
            "field": "age_days",
            "lt": 14
          }
        ]
      }
    ],
    "keep": [
      {
        "id": "keep-receipts",
        "place": "label",
        "path": "Talos/Keep/Receipts & invoices",
        "when": [
          {
            "field": "value",
            "in": [
              "record_financial"
            ]
          }
        ]
      },
      {
        "id": "keep-legal",
        "place": "label",
        "path": "Talos/Keep/Contracts & legal",
        "when": [
          {
            "field": "value",
            "in": [
              "record_legal"
            ]
          }
        ]
      },
      {
        "id": "keep-accounts",
        "place": "label",
        "path": "Talos/Keep/Accounts & licences",
        "when": [
          {
            "field": "value",
            "in": [
              "record_account"
            ]
          }
        ]
      },
      {
        "id": "keep-knowledge",
        "place": "label",
        "path": "Talos/Keep/Knowledge",
        "when": [
          {
            "field": "value",
            "in": [
              "knowledge",
              "decision",
              "reference"
            ]
          }
        ]
      },
      {
        "id": "keep-memories",
        "place": "label",
        "path": "Talos/Keep/Memories",
        "when": [
          {
            "field": "value",
            "in": [
              "memory"
            ]
          }
        ]
      }
    ],
    "automated": [
      {
        "id": "auto-alerts",
        "place": "label",
        "path": "Talos/Automated/Alerts & reports",
        "why": "Machine mail, short-lived: backups, monitoring, alarms, incidents, scheduled reports. By kind when it has one, else by type, else by origin.",
        "when": [
          {
            "field": "sender",
            "in": [
              "machine"
            ]
          },
          {
            "use": "short_lived"
          },
          {
            "field": "kind",
            "in": [
              "alert",
              "report"
            ],
            "else": {
              "field": "type",
              "in": [
                "backup",
                "alert",
                "security_event",
                "alarm",
                "incident",
                "maintenance",
                "report"
              ],
              "else": {
                "field": "origin",
                "in": [
                  "alert",
                  "system_report"
                ]
              }
            }
          }
        ]
      },
      {
        "id": "auto-marketing",
        "place": "label",
        "path": "Talos/Automated/Marketing & newsletters",
        "why": "Machine mail, short-lived: newsletters, offers, webinars, surveys, cold sales, listing alerts.",
        "when": [
          {
            "field": "sender",
            "in": [
              "machine"
            ]
          },
          {
            "use": "short_lived"
          },
          {
            "field": "kind",
            "in": [
              "offer",
              "announcement"
            ],
            "else": {
              "field": "type",
              "in": [
                "newsletter",
                "promotion",
                "event_webinar",
                "survey",
                "digest",
                "creator_post",
                "job_ad",
                "sales_outreach",
                "partner_offer",
                "listing_alert",
                "announcement"
              ],
              "else": {
                "field": "origin",
                "in": [
                  "marketing"
                ]
              }
            }
          }
        ]
      },
      {
        "id": "auto-notifications",
        "place": "label",
        "path": "Talos/Automated/Notifications",
        "why": "Every other machine mail that is short-lived: account and service notices, orders and deliveries, sign-in codes, calendar replies, GitHub.",
        "when": [
          {
            "field": "sender",
            "in": [
              "machine"
            ]
          },
          {
            "use": "short_lived"
          }
        ]
      }
    ],
    "to-sort": [
      {
        "id": "to-sort",
        "place": "label",
        "path": "Talos/To sort",
        "why": "Nothing above decided it: no value, no topic, or a person's mail with no area. Visible, so it can be worked through.",
        "when": []
      }
    ]
  },
  "accounts": {
    "gmail": {
      "name": "Gmail",
      "inbox": {
        "labels": [
          "\\Inbox"
        ]
      },
      "targets": [
